<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2026.2.1</Version>
		<RootNamespace>LMKit.Integrations.Aws</RootNamespace>
		<AssemblyName>LM-Kit.NET.Integrations.Aws</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Configurations>Debug;Release</Configurations>
		<!-- Signing intentionally off until the organization key is wired in for release. -->
		<SignAssembly>False</SignAssembly>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.BedrockRuntime" Version="3.7.*" />
		<PackageReference Include="LM-Kit.NET" Version="2026.7.4" />
	</ItemGroup>

	<!-- System.Text.Json flows transitively from LM-Kit.NET (10.0.10) on all frameworks. -->
</Project>
